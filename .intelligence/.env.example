# Unified Intelligence Backend - Environment Variables

# API Server
PORT=3000
API_KEY=<generate with: openssl rand -hex 32>

# MCP Protocol (OAuth 2.1 + PKCE)
SERVER_URL=https://your-intelligence-server.example.com
OAUTH_CLIENT_ID=<generate with: uuidgen>
OAUTH_CLIENT_SECRET=<generate with: openssl rand -hex 32>
OAUTH_PASSWORD_HASH=<generate with: node -e "require('bcrypt').hash('password', 12).then(console.log)">
SESSION_SECRET=<generate with: openssl rand -hex 64>

# Database
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<from Supabase dashboard>
SUPABASE_ANON_KEY=<from Supabase dashboard>

# Timezone
# IANA timezone name for GCal event operations (e.g. America/New_York, Europe/London, Asia/Tokyo)
# Defaults to UTC if not set
VAULT_TIMEZONE=UTC

# AI Services
GEMINI_API_KEY=<from Google AI Studio>
OPENAI_API_KEY=<from OpenAI dashboard>
SUPADATA_API_KEY=<optional, from Supadata for fast YouTube extraction>

# Queue Configuration
INTELLIGENCE_QUEUE=intelligence_queue
EMBEDDINGS_QUEUE=embeddings_queue
ALLOW_PROD_QUEUES=false

# Logging
LOG_LEVEL=debug
