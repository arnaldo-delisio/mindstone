# MindStone MCP Server — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# === Server ===
# Public Railway URL — set automatically by Railway after first deploy
# SERVER_URL=https://mindstone-xxx.up.railway.app
SERVER_URL=

# === Supabase ===
# From: Supabase dashboard → Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Transaction mode connection string (port 6543) — from Supabase dashboard → Settings → Database → Connection string
DATABASE_URL=

# === MCP Authentication ===
# Generate client ID: uuidgen
OAUTH_CLIENT_ID=
# Generate secret: openssl rand -hex 32
OAUTH_CLIENT_SECRET=
# Generate password hash: node -e "require('bcrypt').hash('yourpassword', 12).then(console.log)"
OAUTH_PASSWORD_HASH=
# Generate session secret: openssl rand -hex 64
SESSION_SECRET=
# Generate API key: openssl rand -hex 32
API_KEY=

# === AI / Embeddings ===
# OpenAI API key — https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Gemini API key — https://aistudio.google.com/apikey (used for content tagging and summarization)
GEMINI_API_KEY=
# Supadata API key — https://supadata.ai (used for YouTube transcript extraction)
SUPADATA_API_KEY=

# === Timezone (optional) ===
# Your local timezone for calendar events. Defaults to UTC if not set.
# Find your timezone name: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
VAULT_TIMEZONE=America/New_York

# === Google Calendar (optional — required only if using GCal sync) ===
# From your Google Calendar → Settings → Calendar ID
GCAL_CALENDAR_PERSONAL=
GCAL_CALENDAR_FAMILY=
GCAL_CALENDAR_WORK=
GCAL_CALENDAR_HEALTH=
# Meals calendar (used by plan_meal tool)
GCAL_CALENDAR_MEALS=
# Path to GCal OAuth credentials file (created during gcal-oauth-setup)
GCAL_CREDENTIALS_PATH=
GCAL_TOKEN_PATH=

# === Queue Control ===
# Set to 'true' in production to use real queues (default: test queues only)
ALLOW_PROD_QUEUES=false
