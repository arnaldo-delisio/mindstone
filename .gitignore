# MindStone .gitignore

# Environment variables — NEVER commit these
.env
.env.*
*.env

# Google Calendar OAuth credentials
credentials.json
token.json

# Dependencies
node_modules/

# Build output
dist/
.next/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# pm2 state
.pm2/

# Sync daemon state
.daemon/.sync/

# IDE
.vscode/settings.json
.idea/

# Temporary files
*.tmp
*.temp

# Internal planning docs (never commit)
.planning/
