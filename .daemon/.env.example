# MindStone Sync Daemon — required environment variables
# Copy to .daemon/.env and fill in your values

# Supabase project URL (from Project Settings → API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase service role key (from Project Settings → API → service_role)
# IMPORTANT: Never expose this key client-side
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Absolute path to your local vault directory
VAULT_PATH=/absolute/path/to/your/vault

# Supabase user ID to associate synced files with
# Run: SELECT id FROM users LIMIT 1; in Supabase SQL editor
VAULT_USER_ID=00000000-0000-0000-0000-000000000001

# Log level: trace, debug, info, warn, error (default: info)
# LOG_LEVEL=info
